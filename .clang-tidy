# yaml-language-server: $schema=https://json.schemastore.org/clang-tidy.json

Checks: >
  -*,

  bugprone-*,
  -bugprone-exception-escape,
  -bugprone-forwarding-reference-overload,
  -bugprone-lambda-function-name,
  -bugprone-macro-repeated-side-effects,
  -bugprone-easily-swappable-parameters,

  cert-*,
  -cert-dcl21-cpp,
  -cert-err58-cpp,

  clang-analyzer-*,

  misc-*,
  -misc-non-private-member-variables-in-classes,
  -misc-use-anonymous-namespace,
  -misc-no-recursion,

  performance-*,
  -performance-unnecessary-value-param,

  portability-*,

  readability-*,
  -readability-braces-around-statements,
  -readability-magic-numbers,
  -readability-named-parameter,
  -readability-uppercase-literal-suffix,
  -readability-function-cognitive-complexity,
  -readability-function-size,

  -modernize-*,
  -cppcoreguidelines-*,
  -hicpp-*,
  -llvm-*,
  -google-*

WarningsAsErrors: "bugprone-use-after-move,clang-analyzer-core.NullDereference"
HeaderFilterRegex: ".*"
FormatStyle: "llvm"

CheckOptions:
  - key: readability-identifier-length.IgnoredVariableNames
    value: "i|j|k|m2|lo|hi|a|b"

  - key: readability-identifier-length.IgnoredParameterNames
    value: "i|j|k|m2|lo|hi|a|b"

  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.FunctionIgnoredRegexp
    value: "^_[a-z][a-z0-9_]*$"

  - key: bugprone-reserved-identifier.AllowedIdentifiers
    value: "^_[a-z][a-z0-9_]*$"
  - key: cert-dcl37-c.AllowedIdentifiers
    value: "^_[a-z][a-z0-9_]*$"
  - key: cert-dcl51-cpp.AllowedIdentifiers
    value: "^_[a-z][a-z0-9_]*$"

  - key: readability-identifier-naming.VariableCase
    value: lower_case

  - key: readability-identifier-naming.GlobalVariableCase
    value: lower_case

  - key: readability-identifier-naming.MemberCase
    value: lower_case

  - key: readability-identifier-naming.PublicMemberCase
    value: lower_case

  - key: readability-identifier-naming.ParameterCase
    value: lower_case

  - key: readability-identifier-naming.LocalVariableCase
    value: lower_case

  - key: readability-identifier-naming.StructCase
    value: CamelCase

  - key: readability-identifier-naming.EnumCase
    value: CamelCase

  - key: readability-identifier-naming.TypedefCase
    value: CamelCase
  - key: readability-identifier-naming.TypedefIgnoredRegexp
    value: "(uint8|uint16|uint32|uint64|uint_large|int8|int16|int32|int64|int_large|f_real|boolean|real32|real64|byte|timestamp)$"

  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
  - key: readability-identifier-naming.MacroDefinitionIgnoredRegexp
    value: "^_?[a-z][a-z0-9_]*$"
