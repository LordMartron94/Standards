# =============================================================================
# INFRASTRUCTURE STANDARDS (Synced across repositories & devices)
# =============================================================================

# Project-Specific Aliases
alias fmt='go fmt ./...'

export PATH="$PATH:$HOME/go/bin:$HOME/.cargo/bin"

alias clang="~/.local/opt/llvm/bin/clang"
alias clang++="~/.local/opt/llvm/bin/clang++"

project_clean() {
    echo "Cleaning project artefacts in $CURRENT_PROJECT_ROOT..."
    find "$CURRENT_PROJECT_ROOT" -name "*.tmp" -delete
}

if ! mtype _helm &>/dev/null; then

    _helm() {
        local helm_bin
        helm_bin="$(command -v helm 2>/dev/null)" || return

        mapfile -t COMPREPLY < <(
            COMP_CWORD="${COMP_CWORD}" "${helm_bin}" __complete -- "${COMP_WORDS[@]}" 2>/dev/null
        )
    }

    complete -F _helm helm
fi