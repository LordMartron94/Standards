#!/bin/sh
# Keeps a local `public` branch fast-forwarded to master automatically, so a
# direct commit to master doesn't need a manual `merge master` into public
# afterward. See ./post-merge for the merge/pull case, and
# ./lib/sync-public-branch.sh for the shared logic and its safety limits
# (fast-forward only, never pushes).
set -eu

repo_root=$(git rev-parse --show-toplevel)
. "$(dirname "$0")/lib/sync-public-branch.sh"
sync_public_branch "$repo_root"
