#!/bin/sh
# Safety net for fast-forward merges into master, which git never runs
# ./pre-merge-commit for. Gates any push that moves refs/heads/master behind
# the deep-review skill, reviewing exactly the commit range being pushed.
# Once a given master update is not blocked (gate passed, or nothing to
# review), also pushes a local `public` branch to the `gh` remote, if both
# exist -- so master and public's remotes never drift apart. See
# ./lib/push-public-branch.sh for that half.
#
# Installed via `core.hooksPath` by tools/scripts/install-git-hooks.sh, into
# MergeSource and every submodule that opts in. See
# adr/0001-deep-review-gate-on-master-merges.md.
set -eu

repo_root=$(git rev-parse --show-toplevel)
empty_tree=4b825dc642cb6eb9a060e54bf8d69288fbee4904
zero_sha=0000000000000000000000000000000000000000

. "$(dirname "$0")/lib/deep-review-gate.sh"
. "$(dirname "$0")/lib/push-public-branch.sh"

blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/master" ] || continue
  [ "$local_sha" = "$zero_sha" ] && continue # deleting the remote branch

  base="$remote_sha"
  [ "$base" = "$zero_sha" ] && base="$empty_tree" # first push creating master

  diff=$(git -C "$repo_root" diff "$base..$local_sha" -- '*.c' '*.h')
  if [ -n "$diff" ]; then
    if ! run_deep_review_gate "$repo_root" "$diff" "pre-push to master ($local_ref)"; then
      blocked=1
      continue
    fi
  fi

  push_public_branch "$repo_root"
done

exit "$blocked"
