# yaml-language-server: $schema=https://json.schemastore.org/clang-format.json
Language: C
BasedOnStyle: LLVM

IndentWidth: 2
TabWidth: 2
UseTab: Never
ColumnLimit: 150

# Hand-wrapped comment prose is authoritative: reflow would merge adjacent
# lines of a labeled-slot doc block (CONVENTIONS.md § Documentation) into one
# paragraph. See adr/0001-prose-first-labeled-doc-comments.md.
ReflowComments: false

BreakBeforeBraces: Attach

AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: None

SortIncludes:
  Enabled: false

AlignConsecutiveAssignments: Consecutive
AlignConsecutiveDeclarations: Consecutive
AlignConsecutiveMacros: Consecutive

PointerAlignment: Right
IndentPPDirectives: AfterHash

AllowShortEnumsOnASingleLine: false
