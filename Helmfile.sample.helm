/*
This is a sample helm file useful to copy into new projects.
*/

BUILD_DIR = "build"
DEV_BIN_DIR = "build/dev-bin"
LOGS_DIR = "logs"

ID_GEN_BINARY = "build/dev-bin/essence_cli"

SHIELD_BINARY = "build/dev-bin/shield_cli"
SHIELD_CONFIG = "shield_config.toml"

target generate_generic() {
    help = "Run go generate for standard Go modules (Natively Cached)"

    matrix MOD in [
        "libs/autarch",
		"libs/blaze",
		// ... fill with all libraries and tools that need generation
    ]

    artifacts {
        inputs = [
            glob("${MOD}", include="**/*.go", exclude="**/*_gen.go", exclude="**/*_string.go"),
            glob("${MOD}", include="**/*.sql"),
            glob("${MOD}", include="**/*.proto")
        ]
        outputs = [
            glob("${MOD}", include="**/*_gen.go"),
            glob("${MOD}", include="**/*_string.go")
        ]
    }

    run "sh -c 'cd ${MOD} && go generate ./...'"
}

